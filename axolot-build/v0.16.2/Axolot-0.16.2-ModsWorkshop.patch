--- /dev/null
+++ b/src/mods162.css
@@ -0,0 +1,65 @@
+/* Axolot 0.16.2 – native Mods Workshop. Scoped to the actual Tauri launcher. */
+.native161-app .axo-workspace>section.mc162-mods{
+  display:grid!important;grid-template-rows:155px 49px minmax(0,1fr) 27px!important;gap:0!important;
+  width:100%!important;height:100%!important;min-height:0!important;min-width:0!important;
+  padding:0!important;margin:0!important;overflow:hidden!important;border:0!important;border-radius:0!important;
+  background:#071626!important;color:#eaf3ff!important;font-family:Inter,"Segoe UI",system-ui,sans-serif!important
+}
+.mc162-mods *{box-sizing:border-box}.mc162-mods button,.mc162-mods select,.mc162-mods input{font-family:inherit}
+.mc162-mods button,.mc162-mods label.mc162-accent-file,.mc162-mods label.mc162-dropzone{cursor:pointer}
+.mc162-mods button:disabled{cursor:default;opacity:.48}
+.mc162-hero{min-height:0;display:flex;align-items:center;justify-content:space-between;gap:16px;position:relative;padding:18px clamp(20px,2.3vw,36px);
