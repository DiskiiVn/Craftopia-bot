+/* =========================================================
+   AXOLOT 0.12.4 — FIXED DESKTOP SHELL
+   Whole launcher stays still. Only content-heavy sub-pages
+   scroll inside their own viewports.
+   ========================================================= */
+html,body,#root{width:100%;height:100%;overflow:hidden!important}
+body{margin:0}
+.axo-app{width:100vw;height:100vh;min-height:0!important;overflow:hidden!important}
+.axo-topbar{position:relative!important;z-index:50!important;height:76px!important;margin:10px 14px 0!important;padding:0 18px!important;display:flex!important;align-items:center!important;gap:18px!important;border-radius:22px!important}
+.axo-brand{min-width:210px}.top-actions{margin-left:auto}.status-chip{display:none!important}.user-chip small{display:none!important}
+.top-nav{position:fixed!important;z-index:100!important;left:14px!important;top:98px!important;width:70px!important;height:calc(100vh - 116px)!important;padding:10px 8px!important;display:flex!important;flex-direction:column!important;justify-content:flex-start!important;gap:9px!important;border:1px solid rgba(136,248,230,.10)!important;border-radius:26px!important;background:linear-gradient(180deg,rgba(8,16,26,.94),rgba(7,13,24,.82))!important;backdrop-filter:blur(28px)!important;box-shadow:0 20px 70px rgba(0,0,0,.34),inset 0 1px rgba(255,255,255,.04)!important}
+.top-nav button{width:52px!important;height:52px!important;min-width:52px!important;display:grid!important;place-items:center!important;padding:0!important;border-radius:17px!important}.top-nav button span{display:none!important}.top-nav button svg{width:20px;height:20px}.top-nav button.active{background:linear-gradient(135deg,rgba(105,246,226,.95),rgba(176,112,255,.94))!important;color:#071015!important;box-shadow:0 8px 30px rgba(112,226,255,.24),0 8px 34px rgba(192,98,255,.18)!important}.top-nav button:before,.top-nav button:after{display:none!important}
+.axo-workspace{position:relative!important;height:calc(100vh - 96px)!important;min-height:0!important;max-width:none!important;margin:0 0 0 96px!important;padding:12px 18px 18px 8px!important;overflow:hidden!important}
+.axo-home-fixed{height:100%;min-height:0;display:grid;grid-template-columns:minmax(620px,1fr) minmax(310px,360px);gap:16px;animation:none!important}
+.axo-home-main{min-width:0;min-height:0;display:grid;grid-template-rows:minmax(390px,1.6fr) minmax(205px,.72fr);gap:16px}
+.axo-stage{position:relative;overflow:hidden;min-height:0;border-radius:28px;background:radial-gradient(circle at 57% 42%,rgba(76,242,221,.13),transparent 27%),radial-gradient(circle at 88% 12%,rgba(138,103,255,.13),transparent 32%),linear-gradient(135deg,rgba(6,20,25,.96),rgba(10,17,32,.93))}
+.axo-stage:before{content:"";position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(rgba(113,239,222,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(113,239,222,.025) 1px,transparent 1px);background-size:36px 36px;mask-image:linear-gradient(to bottom,rgba(0,0,0,.72),transparent)}
+.axo-stage:after{content:"";position:absolute;left:10%;right:8%;bottom:-26%;height:56%;border-radius:50%;background:radial-gradient(ellipse,rgba(102,221,255,.13),rgba(184,104,255,.09) 42%,transparent 70%);filter:blur(16px);pointer-events:none}
+.axo-stage-head{position:relative;z-index:4;display:flex;justify-content:space-between;align-items:flex-start;padding:24px 26px}.axo-stage-head h2{margin:5px 0 1px;font-size:25px}.axo-stage-head small{color:var(--muted)}
+.stage-state{display:flex;align-items:center;gap:7px;padding:8px 11px;border:1px solid rgba(255,255,255,.07);border-radius:100px;background:rgba(5,12,18,.54);font-size:12px}.stage-state i{width:7px;height:7px;border-radius:50%;background:#56f2aa;box-shadow:0 0 14px #56f2aa}.stage-state.game-crashed i{background:#ff7f8f;box-shadow:0 0 14px #ff7f8f}
+.axo-stage-visual{position:absolute;inset:58px 0 82px;display:grid;place-items:center}.axo-stage-glow{position:absolute;width:min(430px,55vh);height:min(430px,55vh);border-radius:50%;background:radial-gradient(circle,rgba(91,243,222,.12),rgba(118,132,255,.08) 42%,transparent 70%);filter:blur(8px)}.axo-portal-home{position:relative!important;width:min(370px,44vh)!important;height:min(370px,44vh)!important;right:auto!important;top:auto!important;transform:none!important}.axo-portal-home .ring-outer{width:100%;height:100%}.axo-portal-home .ring-mid{width:79%;height:79%}.axo-portal-home .ring-inner{width:62%;height:62%}
+.axo-stage-control{position:absolute;z-index:6;left:20px;right:20px;bottom:18px;height:72px;display:flex;align-items:center;gap:12px;padding:10px;border:1px solid rgba(143,248,231,.12);border-radius:21px;background:rgba(5,12,23,.82);backdrop-filter:blur(20px);box-shadow:0 15px 45px rgba(0,0,0,.30),inset 0 1px rgba(255,255,255,.035)}
+.stage-profile-icon{width:49px;height:49px;display:grid;place-items:center;border-radius:15px;color:#76f2df;background:linear-gradient(135deg,rgba(83,244,218,.14),rgba(110,170,255,.10))}.stage-profile-info{min-width:0;display:flex;flex-direction:column;flex:1}.stage-profile-info b{font-size:15px}.stage-profile-info small{margin-top:3px;color:var(--muted)}
+.stage-small-action{width:48px;height:48px;display:grid;place-items:center;padding:0;border-radius:15px;border:1px solid rgba(255,255,255,.08);color:#ccece7;background:rgba(255,255,255,.025);cursor:pointer}.stage-launch{width:154px;height:52px;display:grid;place-items:center;border:0;border-radius:17px;color:#07101a;background:linear-gradient(105deg,#63f2df,#66caf7 50%,#d377ff);box-shadow:0 10px 34px rgba(83,230,224,.22),0 9px 36px rgba(182,104,255,.20);cursor:pointer;transition:transform .18s ease,filter .18s ease}.stage-launch:hover:not(:disabled){transform:translateY(-2px) scale(1.015);filter:brightness(1.08)}.stage-launch:disabled{opacity:.6}
+.home-library{min-height:0;overflow:hidden;display:flex;flex-direction:column;padding:10px;border-radius:25px}.home-library-tabs{display:flex;gap:6px;padding-bottom:9px;border-bottom:1px solid rgba(255,255,255,.055)}.home-library-tabs button{min-height:38px;display:flex;align-items:center;gap:8px;padding:0 15px;border:0;border-radius:13px;color:var(--muted);background:transparent;cursor:pointer}.home-library-tabs button.active{color:#eafffb;background:linear-gradient(135deg,rgba(68,239,219,.12),rgba(168,99,255,.14));box-shadow:inset 0 0 0 1px rgba(117,244,224,.14)}.home-library-tabs .library-new{margin-left:auto;width:40px;padding:0;justify-content:center}
+.home-profile-list{flex:1;min-height:0;padding-top:8px;overflow-y:auto;overscroll-behavior:contain}.home-profile-list::-webkit-scrollbar{width:5px}.home-profile-list::-webkit-scrollbar-thumb{border-radius:20px;background:rgba(113,235,221,.28)}.home-profile-row{min-height:53px;display:flex;align-items:center;gap:11px;margin-bottom:6px;padding:6px 8px;border:1px solid transparent;border-radius:15px;background:rgba(255,255,255,.018);cursor:pointer}.home-profile-row.active{border-color:rgba(90,243,216,.11);background:rgba(74,232,208,.045)}.home-profile-thumb{width:39px;height:39px;display:grid;place-items:center;border-radius:11px;color:#78f3e0;background:rgba(91,239,217,.08)}.home-profile-copy{min-width:0;flex:1;display:flex;flex-direction:column}.home-profile-copy b{font-size:13px}.home-profile-copy small{margin-top:2px;color:var(--muted);font-size:11px}.home-boost{display:flex;align-items:center;gap:4px;padding:4px 7px;border-radius:9px;color:#80f0da;background:rgba(76,229,199,.07);font-size:9px;text-transform:uppercase}.home-row-play{width:39px;height:36px;display:grid;place-items:center;border-radius:11px;border:1px solid rgba(99,242,220,.14);color:#6ef2dd;background:rgba(79,225,203,.035);cursor:pointer}
+.axo-home-side{min-width:0;min-height:0;display:flex;flex-direction:column;gap:13px}.home-account{min-height:84px;display:grid;grid-template-columns:52px 1fr 22px;align-items:center;gap:11px;padding:13px 15px;text-align:left;color:inherit;border-radius:23px;cursor:pointer}.home-account-avatar{width:48px;height:48px;display:grid;place-items:center;border-radius:50%;color:#041315;background:linear-gradient(135deg,#66f1dd,#7aafff,#df83ff)}.home-account>span:nth-child(2){display:flex;flex-direction:column}.home-account b{font-size:14px}.home-account small{margin-top:3px;color:var(--muted)}
+.system-mini{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:10px;border-radius:23px}.system-mini>div{min-width:0;height:92px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid rgba(255,255,255,.055);border-radius:17px;background:rgba(255,255,255,.018)}.system-mini svg{margin-bottom:8px;color:#6ceada}.system-mini b{font-size:14px}.system-mini small{margin-top:2px;color:var(--muted);font-size:10px}
+.client-status-card{padding:17px 18px;border-radius:23px}.client-status-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}.client-status-head b{font-size:11px;color:#dffef8}.client-status-card>small{display:block;margin-top:7px;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--muted);font-size:10px}
