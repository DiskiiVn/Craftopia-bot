+++ b/src/nova151.css
@@ -0,0 +1,103 @@
+/* =========================================================
+   AXOLOT CLIENT 0.15.1 — NOVA UI REBUILD
+   Responsive desktop shell. No fixed canvas, no page-wide scroll.
+   ========================================================= */
+:root{
+  --n151-bg:#07101a;
+  --n151-bg-2:#0a1420;
+  --n151-panel:#0d1824;
+  --n151-panel-2:#111e2c;
+  --n151-panel-3:#152433;
+  --n151-line:rgba(151,214,226,.105);
+  --n151-line-strong:rgba(102,229,218,.24);
+  --n151-text:#edf7f8;
+  --n151-muted:#8198a4;
+  --n151-cyan:#61e6da;
+  --n151-blue:#6f8cff;
+  --n151-violet:#9e7df6;
+  --n151-green:#62e3ab;
+  --n151-warn:#ffc36e;
+  --n151-radius:18px;
+  --n151-top:72px;
+  --n151-nav:72px;
+}
+
+html,body,#root{width:100%!important;height:100%!important;min-width:0!important;min-height:0!important;margin:0!important;overflow:hidden!important;background:var(--n151-bg)!important}
+body{font-size:14px!important;color:var(--n151-text)!important}
+.axo-app{width:100vw!important;height:100vh!important;min-width:0!important;min-height:0!important;max-width:none!important;max-height:none!important;overflow:hidden!important;background:
+  radial-gradient(circle at 8% 18%,rgba(48,208,194,.08),transparent 24%),
+  radial-gradient(circle at 86% 10%,rgba(101,124,255,.11),transparent 30%),
+  linear-gradient(155deg,#07101a 0%,#08121d 46%,#060d15 100%)!important}
+.biolume-field{opacity:.42!important}.motion-field{display:none!important}
+
+/* Top chrome */
+.axo-topbar{position:fixed!important;inset:0 0 auto 0!important;width:100%!important;height:var(--n151-top)!important;margin:0!important;padding:0 18px 0 24px!important;display:flex!important;align-items:center!important;justify-content:space-between!important;gap:18px!important;background:rgba(5,13,22,.94)!important;border:0!important;border-bottom:1px solid var(--n151-line)!important;border-radius:0!important;backdrop-filter:blur(22px)!important;z-index:220!important;box-shadow:0 12px 35px rgba(0,0,0,.18)!important}
+.axo-brand{min-width:210px!important;gap:12px!important}.axo-logo{width:42px!important;height:42px!important;border-radius:14px!important;background:linear-gradient(145deg,var(--n151-cyan),#6dcdf0 55%,var(--n151-violet))!important;box-shadow:0 9px 26px rgba(73,218,208,.16)!important}.axo-brand-copy strong{font-size:14px!important;letter-spacing:.06em!important}.axo-brand-copy small{font-size:8px!important;letter-spacing:.19em!important;color:#69d5ca!important}
+.top-actions{margin-left:auto!important;gap:9px!important}.status-chip{height:40px!important;border-radius:12px!important;padding:0 13px!important;font-size:11px!important;background:#0c1722!important;border:1px solid var(--n151-line)!important;color:#b7c9d0!important}.user-chip{height:44px!important;min-width:190px!important;border-radius:13px!important;background:#0c1722!important;border:1px solid var(--n151-line)!important}.user-chip b{font-size:11px!important}.user-chip small{font-size:9px!important;color:var(--n151-muted)!important}.user-avatar{background:rgba(97,230,218,.08)!important;color:var(--n151-cyan)!important}.round-icon{display:none!important}.nova-command-trigger{height:40px!important;min-width:138px!important;border-radius:12px!important;background:#0c1722!important;border:1px solid var(--n151-line)!important;color:#a8bac2!important;font-size:11px!important}.nova-command-trigger kbd{font-size:8px!important}
+
+/* Sidebar: expands over the page instead of changing page geometry. */
+.top-nav{position:fixed!important;left:14px!important;top:84px!important;bottom:14px!important;width:var(--n151-nav)!important;height:auto!important;margin:0!important;padding:8px!important;display:flex!important;flex-direction:column!important;align-items:stretch!important;justify-content:flex-start!important;gap:5px!important;background:rgba(7,17,28,.97)!important;border:1px solid var(--n151-line)!important;border-radius:20px!important;overflow:hidden!important;z-index:210!important;box-shadow:0 18px 48px rgba(0,0,0,.28)!important;transition:width .18s cubic-bezier(.2,.8,.2,1),box-shadow .18s ease!important}
+.top-nav:hover{width:196px!important;box-shadow:0 24px 72px rgba(0,0,0,.42),0 0 0 1px rgba(97,230,218,.05)!important}
+.top-nav button,.top-nav:hover button{flex:0 0 auto!important;width:100%!important;height:55px!important;min-width:0!important;min-height:55px!important;margin:0!important;padding:0 15px!important;border:0!important;border-radius:13px!important;display:flex!important;flex-direction:row!important;align-items:center!important;justify-content:flex-start!important;gap:13px!important;background:transparent!important;color:#78909b!important;overflow:hidden!important;white-space:nowrap!important;transition:background .15s,color .15s!important}
+.top-nav button svg{min-width:21px!important;width:21px!important;height:21px!important}.top-nav button span{display:block!important;opacity:0!important;transform:translateX(-4px)!important;font-size:11px!important;font-weight:700!important;transition:opacity .14s,transform .14s!important}.top-nav:hover button span{opacity:1!important;transform:none!important}.top-nav button:hover{background:#101f2d!important;color:#e8f4f6!important}.top-nav button.active{background:linear-gradient(135deg,rgba(71,115,255,.92),rgba(112,88,232,.93))!important;color:#fff!important;box-shadow:0 8px 24px rgba(82,99,242,.24)!important}
+
+/* Main workspace truly follows the window size. */
