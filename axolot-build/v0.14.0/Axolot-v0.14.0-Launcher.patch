+fn cleanup_old_axolot_core(dir: &Path, keep_current: bool) -> Result<(), String> {
+    let entries = match std::fs::read_dir(dir) {
+        Ok(entries) => entries,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(()),
+        Err(error) => return Err(error.to_string()),
+    };
+    for entry in entries.flatten() {
+        let path = entry.path();
+        let Some(name) = path.file_name().and_then(|x| x.to_str()) else { continue };
+        let ours = name.starts_with("axolot-core-") || name.starts_with("axolot-client-core-");
+        if !ours { continue; }
+        if keep_current && name == AXOLOT_CORE_FILE { continue; }
+        let _ = std::fs::remove_file(path);
+    }
+    Ok(())
+}
+
+fn axolot_core_supported(game_version: &str, loader: &str) -> bool {
+    loader.eq_ignore_ascii_case("fabric") && game_version == AXOLOT_CORE_GAME_VERSION
+}
+
+#[tauri::command]
+async fn get_axolot_core_status(profile_id: String, game_version: String, loader: String) -> Result<AxolotCoreStatus, String> {
+    let supported = axolot_core_supported(&game_version, &loader);
+    let path = mods_dir(&profile_id)?.join(AXOLOT_CORE_FILE);
+    let installed = path.exists();
+    let detail = if !loader.eq_ignore_ascii_case("fabric") {
+        "Axolot Core requires Fabric.".to_string()
+    } else if game_version != AXOLOT_CORE_GAME_VERSION {
+        format!("Axolot Core {AXOLOT_CORE_VERSION} currently targets Minecraft {AXOLOT_CORE_GAME_VERSION}.")
+    } else if installed {
+        "Axolot Core is installed and ready for this profile.".to_string()
+    } else {
+        "Axolot Core is compatible and can be installed for this profile.".to_string()
+    };
+    Ok(AxolotCoreStatus {
+        supported,
+        installed,
+        version: AXOLOT_CORE_VERSION.into(),
+        path: path.to_string_lossy().to_string(),
+        detail,
+    })
+}
+
+#[tauri::command]
+async fn install_axolot_core(profile_id: String, game_version: String, loader: String) -> Result<AxolotCoreStatus, String> {
+    if !axolot_core_supported(&game_version, &loader) {
+        return get_axolot_core_status(profile_id, game_version, loader).await;
