+.top-actions{gap:8px!important}.status-chip{height:40px!important;border-radius:13px!important}.user-chip{height:42px!important;min-width:205px!important;border-radius:13px!important}.round-icon{width:42px!important;height:42px!important;border-radius:13px!important}
