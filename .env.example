DISCORD_TOKEN=replace-with-your-bot-token
DISCORD_GUILD_ID=0
GEMINI_API_KEY=replace-with-your-free-google-ai-studio-key
GEMINI_MODEL=gemini-3.5-flash-lite
SERVER_NAME=Craftopia
SUPPORT_CHANNEL_IDS=
# Chỉ điền các kênh chuyên dùng để hỏi AI; tin nhắn tại đó sẽ được gửi tới Gemini.
AI_AUTO_REPLY_CHANNEL_IDS=
STAFF_ROLE_ID=0
STATUS_CHANNEL_ID=0
# ID kênh có dashboard tự cập nhật; để 0 rồi chạy /stats_setup trong Discord.
STATS_CHANNEL_ID=0
STATS_UPDATE_SECONDS=120
# false dùng số tổng hợp xấp xỉ và chạy ngay. true cần bật Members + Presence Intent.
TRACK_DISCORD_PRESENCE=false
# Craftopia Music: để MUSIC_DJ_ROLE_ID=0 nếu chỉ dùng quyền Manage Server cho stop/leave.
MUSIC_ENABLED=true
# false = bot ở lại voice 24/7; true = tự rời khi queue/kênh trống.
MUSIC_AUTO_LEAVE=false
MUSIC_DJ_ROLE_ID=0
MUSIC_MAX_QUEUE=100
MUSIC_MAX_PER_USER=20
MUSIC_MAX_PLAYLIST=20
MUSIC_MAX_DURATION_SECONDS=10800
MUSIC_ALLOW_LIVE=false
MUSIC_IDLE_SECONDS=180
# Chờ Discord tự nối lại trước khi kết luận bot đã mất voice.
MUSIC_VOICE_DISCONNECT_GRACE_SECONDS=12
MUSIC_RESOLVE_TIMEOUT_SECONDS=35
MUSIC_RESOLVE_WORKERS=2
MUSIC_BITRATE_KBPS=128
MUSIC_DEFAULT_VOLUME=80
# Chỉ URL thuộc allowlist này được nhận; tìm kiếm bằng chữ dùng YouTube.
MUSIC_ALLOWED_HOSTS=youtube.com,youtu.be,soundcloud.com
# Để trống để tự ưu tiên FFmpeg hệ thống rồi mới dùng binary dự phòng imageio-ffmpeg.
FFMPEG_PATH=
MONITOR_ALL_CHANNELS=true
# Bắt buộc loại trừ kênh staff, ticket, log và kênh nhạy cảm; các ID cách nhau bằng dấu phẩy.
MONITOR_EXCLUDED_CHANNEL_IDS=
MC_HOST=play.craftopics.online
JAVA_PORT=25565
BEDROCK_PORT=19132
STATUS_CHECK_SECONDS=60
STATUS_CACHE_SECONDS=15
STATUS_FAILURE_THRESHOLD=3
STATUS_RECOVERY_THRESHOLD=2
MONITOR_WINDOW_SECONDS=180
MONITOR_COOLDOWN_SECONDS=900
MONITOR_MAX_ALERTS_PER_HOUR=3
MAX_AI_CONCURRENCY=3
MAX_QUESTIONS_PER_MINUTE=4
MAX_HISTORY_MESSAGES=6
MAX_HISTORY_MINUTES=30
# Tổng dung lượng ảnh cho mỗi yêu cầu AI, không phải dung lượng cho từng ảnh.
MAX_IMAGE_MB=8
MAX_UPLOAD_MB=25
# ~hl không cắt âm thầm; nội dung vượt giới hạn này sẽ bị từ chối.
MAX_TRAINING_CHARS=50000
# Xoá tin nhắn luôn cần preview + nút xác nhận; mặc định chỉ kênh hiện tại.
DELETE_SCAN_LIMIT_PER_CHANNEL=5000
DELETE_SCAN_LIMIT_TOTAL=20000
DELETE_MAX_MESSAGES=500
DELETE_CONFIRM_SECONDS=120
DELETE_SCAN_COOLDOWN_SECONDS=30
SYNC_COMMANDS=true
LOG_LEVEL=INFO
