e_text(s,encoding="utf-8")

p=root/"src-tauri/src/lib.rs"; s=p.read_text(encoding="utf-8")
s=s.replace('const USER_AGENT: &str = "AxolotClient/0.10.1 (+https://axolot.local)";','const USER_AGENT: &str = "AxolotClient/0.11.1 (+https://axolot.local)";\nconst AXOLOT_CURSEFORGE_PROXY: &str = "https://rlbgvgosxrhqnppbrtey.supabase.co/functions/v1/axolot-curseforge";')
start=s.index("fn require_curseforge_key")
end=s.index("#[tauri::command]\nasync fn install_optimization_pack",start)
s=s[:start]+'async fn curseforge_proxy_json(\n    client: &reqwest::Client,\n    path: &str,\n    params: &[(String, String)],\n) -> Result<Value, String> {\n    let mut query = vec![("path".to_string(), path.to_string())];\n    query.extend_from_slice(params);\n    client.get(AXOLOT_CURSEFORGE_PROXY)\n        .header("Accept", "application/json")\n        .header("User-Agent", USER_AGENT)\n        .query(&query)\n        .send().await.map_err(|e| format!("Could not connect to Axolot CurseForge proxy: {e}"))?\n        .error_for_status().map_err(|e| format!("Axolot CurseForge proxy returned an error: {e}"))?\n        .json().await.map_err(|e| format!("Invalid CurseForge proxy response: {e}"))\n}\n\nasync fn curseforge_file_info(\n    client: &reqwest::Client,\n    mod_id: u64,\n    file_id: u64,\n) -> Result<(String, String), String> {\n    let path = format!("/v1/mods/{mod_id}/files/{file_id}");\n    let response = curseforge_proxy_json(client, &path, &[]).await?;\n    let data = response.get("data").ok_or("CurseForge file response is missing data")?;\n    let file_name = data.get("fileName").and_then(Value::as_str).ok_or("CurseForge file has no fileName")?.to_string();\n    if let Some(download) = data.get("downloadUrl").and_then(Value::as_str).filter(|s| !s.is_empty()) {\n        return Ok((download.to_string(), file_name));\n    }\n    let download_path = format!("/v1/mods/{mod_id}/files/{file_id}/download-url");\n    let download_response = curseforge_proxy_json(client, &download_path, &[]).await?;\n    let download_url = download_response.get("data").and_then(Value::as_str)\n        .filter(|s| !s.is_empty())\n        .ok_or("This CurseForge file cannot be redistributed/downloaded through the API")?;\n    Ok((download_url.to_string(), file_name))\n}\n\nasync fn curseforge_pick_file(\n    client: &reqwest::Client,\n    mod_id: u64,\n    game_version: &str,\n    loader: &str,\n) -> Result<(u64, String, String), String> {\n    let path = format!("/v1/mods/{mod_id}/files");\n    let mut query: Vec<(String, String)> = vec![\n        ("gameVersion".into(), game_version.to_string()),\n        ("pageSize".into(), "50".into()),\n    ];\n    if let Some(loader_type) = curseforge_loader_type(loader) {\n        query.push(("modLoaderType".into(), loader_type.to_string()));\n    }\n    let response = curseforge_proxy_json(client, &path, &query).await?;\n    let files = response.get("data").and_then(Value::as_array).ok_or("CurseForge returned no file list")?;\n    let file = files.first().ok_or_else(|| format!("No CurseForge file matches Minecraft {game_version} / {loader}"))?;\n    let file_id = file.get("id").and_then(Value::as_u64).ok_or("CurseForge file id missing")?;\n    let (download_url, file_name) = curseforge_file_info(client, mod_id, file_id).await?;\n    Ok((file_id, download_url, file_name))\n}\n\n#[tauri::command]\nasync fn search_curseforge(\n    query: String,\n    project_type: String,\n    game_version: String,\n    loader: String,\n) -> Result<Vec<ModrinthHit>, String> {\n    let kind = if project_type == "modpack" { "modpack" } else { "mod" };\n    let class_id = if kind == "modpack" { 4471 } else { 6 };\n    let mut params: Vec<(String, String)> = vec![\n        ("gameId".into(), "432".into()),\n        ("classId".into(), class_id.to_string()),\n        ("gameVersion".into(), game_version.clone()),\n        ("pageSize".into(), "30".into()),\n        ("sortField".into(), "2".into()),\n        ("sortOrder".into(), "desc".into()),\n    ];\n    if !query.trim().is_empty() { params.push(("searchFilter".into(), query)); }\n    if let Some(loader_type) = curseforge_loader_type(&loader) { params.push(("modLoaderType".into(), loader_type.to_string())); }\n\n    let client = reqwest::Client::new();\n    let response = curseforge_proxy_json(&client, "/v1/mods/search", &params).await?;\n    let data = response.get("data").and_then(Value::as_array).ok_or("CurseForge search response is missing data")?;\n    Ok(data.iter().filter_map(|item| {\n        let id = item.get("id")?.as_u64()?;\n        let title = item.get("name")?.as_str()?.to_string();\n        let description = item.get("summary").and_then(Value::as_str).unwrap_or("").to_string();\n        let icon_url = item.pointer("/logo/thumbnailUrl").and_then(Value::as_str).map(str::to_string);\n        let author = item.get("authors").and_then(Value::as_array)\n            .and_then(|authors| authors.first())\n            .and_then(|author| author.get("name"))\n            .and_then(Value::as_str).unwrap_or("CurseForge").to_string();\n        let downloads = item.get("downloadCount").and_then(Value::as_u64).unwrap_or(0);\n        let versions = item.get("latestFilesIndexes").and_then(Value::as_array).map(|indexes| {\n            let mut values = indexes.iter().filter_map(|index| index.get("gameVersion").and_then(Value::as_str).map(str::to_string)).collect::<Vec<_>>();\n            values.sort(); values.dedup(); values\n        }).unwrap_or_default();\n        let categories = item.get("categories").and_then(Value::as_array).map(|categories| {\n            categories.iter().filter_map(|category| category.get("name").and_then(Value::as_str).map(str::to_string)).collect::<Vec<_>>()\n        }).unwrap_or_default();\n        Some(ModrinthHit {\n            project_id: id.to_string(), title, description, icon_url: Some(icon_url).flatten(), author,\n            downloads, versions, categories, project_type: kind.to_string(),\n        })\n    }).collect())\n}\n\n#[tauri::command]\nasync fn install_curseforge_project(\n    profile_id: String,\n    project_id: String,\n    project_type: String,\n    game_version: String,\n    loader: String,\n) -> Result<String, String> {\n    let mod_id = project_id.parse::<u64>().map_err(|_| "Invalid CurseForge project id".to_string())?;\n    let client = reqwest::Client::new();\n    let (_file_id, download_url, file_name) = curseforge_pick_file(&client, mod_id, &game_version, &loader).await?;\n    let bytes = download_bytes(&client, &download_url).await?;\n\n    if project_type != "modpack" {\n        let file_name = safe_file_name(&file_name)?;\n        let dir = mods_dir(&profile_id)?;\n        tokio::fs::create_dir_all(&dir).await.map_err(|e| e.to_string())?;\n        tokio::fs::write(dir.join(&file_name), bytes).await.map_err(|e| e.to_string())?;\n        return Ok(format!("Installed CurseForge mod {file_name}"));\n    }\n\n    let packs = modpacks_dir(&profile_id)?;\n    tokio::fs::create_dir_all(&packs).await.map_err(|e| e.to_string())?;\n    let archive_name = safe_file_name(&file_name)?;\n    let archive_path = packs.join(&archive_name);\n    tokio::fs::write(&archive_path, bytes).await.map_err(|e| e.to_string())?;\n    let archive_for_manifest = archive_path.clone();\n    let manifest = tokio::task::spawn_blocking(move || parse_curseforge_manifest(&archive_for_manifest))\n        .await.map_err(|e| e.to_string())??;\n\n    let mods = mods_dir(&profile_id)?;\n    tokio::fs::create_dir_all(&mods).await.map_err(|e| e.to_string())?;\n    let mut installed = 0usize;\n    for dependency in &manifest.files {\n        if !dependency.required { continue; }\n        let (url, dep_name) = curseforge_file_info(&client, dependency.project_id, dependency.file_id).await?;\n        let dep_bytes = download_bytes(&client, &url).await?;\n        let dep_name = safe_file_name(&dep_name)?;\n        tokio::fs::write(mods.join(dep_name), dep_bytes).await.map_err(|e| e.to_string())?;\n        installed += 1;\n