s=rep(s,"                    <button className={catalogSource==='curseforge'?'active':''} onClick={()=>{setCatalogSource('curseforge');setCatalogProjects([]);setCatalogMessage(curseForgeApiKey.trim()?'Loading real CurseForge catalog…':'CurseForge requires your API key in Settings.');}}>CurseForge</button>","                    <button className={catalogSource==='curseforge'?'active':''} onClick={()=>{setCatalogSource('curseforge');setCatalogProjects([]);setCatalogMessage(curseForgeEnabled?'Loading real CurseForge catalog…':'CurseForge is not configured by the Axolot administrator yet.');}}>CurseForge</button>","main-8",1)
s=rep(s,'              <label className="setting-tile panel-glass"><span>CurseForge developer API key</span><input type="password" value={curseForgeApiKey} onChange={(e)=>setCurseForgeApiKey(e.target.value)} placeholder="Required for CurseForge search/install"/><small>CurseForge requires x-api-key. For public release, move this key behind your own backend proxy instead of shipping it inside the app.</small></label>','              <div className="setting-tile panel-glass cloud-managed"><span>CurseForge catalog</span><b>{curseForgeEnabled ? \'Managed by Axolot Cloud\' : \'Waiting for admin setup\'}</b><small>The CurseForge API key stays on Axolot\'s backend and is never shipped to players.</small></div>',"main-9",1)
s=rep(s,'              <label className="setting-tile panel-glass"><span>Microsoft App Client ID</span><input value={microsoftClientId} onChange={(e)=>setMicrosoftClientId(e.target.value.trim())} placeholder="Your Axolot public-client App ID"/><small>Register Axolot as a public/native Microsoft app and enable device-code login. The Client ID is public; never place a client secret in the launcher.</small></label>','              <div className="setting-tile panel-glass cloud-managed"><span>Microsoft sign-in</span><b>{microsoftClientId ? \'Managed by Axolot Cloud\' : \'Waiting for admin setup\'}</b><small>The public Client ID is delivered automatically. Players never need to paste IDs or secrets.</small></div>',"main-10",1)
s=rep(s,'              <label className="setting-tile panel-glass"><span>Update manifest URL</span><input value={updateManifestUrl} onChange={(e)=>setUpdateManifestUrl(e.target.value)} placeholder={DEFAULT_UPDATE_MANIFEST}/><small>HTTPS endpoint used by Axolot to discover signed release metadata and installer hashes.</small></label>','              <div className="setting-tile panel-glass cloud-managed"><span>Release channel</span><b>Axolot Stable</b><small>{remoteConfig?.latest_launcher_version ? `Admin channel reports v${remoteConfig.latest_launcher_version}` : \'Managed remotely by Axolot Cloud.\'}</small></div>',"main-11",1)
