from pathlib import Path

def rep(s, old, new, label, count=1):
    if old not in s:
        raise SystemExit(f"missing expected block: {label}")
    return s.replace(old,new,count)

root=Path(__file__).resolve().parent / "source"
for rel in ["package.json","src-tauri/Cargo.toml","src-tauri/tauri.conf.json"]:
    p=root/rel; s=p.read_text(encoding="utf-8")
    s=s.replace("0.11.0","0.11.1")
    s=s.replace("Release Candidate 0.11\"","Release Candidate 0.11.1\"")
    p.write_text(s,encoding="utf-8")

p=root/"src/main.tsx"; s=p.read_text(encoding="utf-8")
s=rep(s,'type LauncherUpdateStatus = { current_version: string; latest_version: string; available: boolean; download_url: string; sha256: string; notes: string; mandatory: boolean };\n\nconst DEFAULT_UPDATE_MANIFEST',"type LauncherUpdateStatus = { current_version: string; latest_version: string; available: boolean; download_url: string; sha256: string; notes: string; mandatory: boolean };\ntype RemoteConfig = { microsoft_client_id: string; update_manifest_url: string; latest_launcher_version: string; curseforge_enabled: boolean; curseforge_proxy_url: string; updated_at?: string | null };\n\nconst AXOLOT_PUBLIC_CONFIG_URL = 'https://rlbgvgosxrhqnppbrtey.supabase.co/functions/v1/axolot-public-config';\nconst DEFAULT_UPDATE_MANIFEST","main-0",1)
s=rep(s,"  const [curseForgeApiKey, setCurseForgeApiKey] = React.useState(localStorage.getItem('axolot.curseForgeApiKey') || '');",'  const [remoteConfig, setRemoteConfig] = React.useState<RemoteConfig | null>(null);\n  const [curseForgeEnabled, setCurseForgeEnabled] = React.useState(false);',"main-1",1)
s=rep(s,"  const [microsoftClientId, setMicrosoftClientId] = React.useState(localStorage.getItem('axolot.microsoftClientId') || '');","  const [microsoftClientId, setMicrosoftClientId] = React.useState('');","main-2",1)
s=rep(s,"  const [updateManifestUrl, setUpdateManifestUrl] = React.useState(localStorage.getItem('axolot.updateManifestUrl') || DEFAULT_UPDATE_MANIFEST);",'  const [updateManifestUrl, setUpdateManifestUrl] = React.useState(DEFAULT_UPDATE_MANIFEST);',"main-3",1)
s=rep(s,"      setBootPercent(58);\n      setBootMessage('Checking Axolot update channel...');\n      try {\n        const update = await invoke<LauncherUpdateStatus>('check_launcher_update', { manifestUrl: updateManifestUrl.trim() || DEFAULT_UPDATE_MANIFEST });\n        if (cancelled) return;\n        setUpdateStatus(update);\n        if (update.available && autoInstallUpdates) {\n          setBootPercent(72);\n          setBootMessage(`Updating Axolot Client to ${update.latest_version}...`);\n          setUpdatingLauncher(true);\n          await invoke<string>('install_launcher_update', { downloadUrl: update.download_url, sha256: update.sha256 });\n          return;\n        }\n      } catch {\n        // The launcher remains usable when the update endpoint is temporarily unavailable.\n      }\n","      setBootPercent(52);\n      setBootMessage('Syncing Axolot cloud configuration...');\n      let manifestForBoot = DEFAULT_UPDATE_MANIFEST;\n      try {\n        const response = await fetch(AXOLOT_PUBLIC_CONFIG_URL, { cache: 'no-store' });\n        if (response.ok) {\n          const config = await response.json() as RemoteConfig;\n          if (cancelled) return;\n          setRemoteConfig(config);\n          setMicrosoftClientId((config.microsoft_client_id || '').trim());\n          setCurseForgeEnabled(Boolean(config.curseforge_enabled));\n          manifestForBoot = (config.update_manifest_url || DEFAULT_UPDATE_MANIFEST).trim();\n          setUpdateManifestUrl(manifestForBoot);\n        }\n      } catch {\n        // Cloud configuration is optional for offline-only use.\n      }\n      if (cancelled) return;\n      setBootPercent(64);\n      setBootMessage('Checking Axolot update channel...');\n      try {\n        const update = await invoke<LauncherUpdateStatus>('check_launcher_update', { manifestUrl: manifestForBoot });\n        if (cancelled) return;\n        setUpdateStatus(update);\n        if (update.available && autoInstallUpdates) {\n          setBootPercent(76);\n          setBootMessage(`Updating Axolot Client to ${update.latest_version}...`);\n          setUpdatingLauncher(true);\n          await invoke<string>('install_launcher_update', { downloadUrl: update.download_url, sha256: update.sha256 });\n          return;\n        }\n      } catch {\n        // The launcher remains usable when the update endpoint is temporarily unavailable.\n      }\n","main-4",1)
s=rep(s,"    localStorage.setItem('axolot.curseForgeApiKey', curseForgeApiKey.trim());\n    localStorage.setItem('axolot.microsoftClientId', microsoftClientId.trim());\n    localStorage.setItem('axolot.updateManifestUrl', updateManifestUrl.trim() || DEFAULT_UPDATE_MANIFEST);\n",'',"main-5",1)
