    }\n\n    let root = profile_root(&profile_id)?;\n    let archive_clone = archive_path.clone();\n    let root_clone = root.clone();\n    tokio::task::spawn_blocking(move || -> Result<(), String> {\n        extract_archive_prefix(&archive_clone, &root_clone, "overrides")?;\n        extract_archive_prefix(&archive_clone, &root_clone, "client-overrides")?;\n        Ok(())\n    }).await.map_err(|e| e.to_string())??;\n\n    Ok(format!("Installed CurseForge modpack {archive_name} • {installed} dependency file(s) + overrides."))\n}\n\n\n'+s[end:]
s=s.replace('if client_id.len() < 8 { return Err("Configure your Axolot Microsoft App Client ID in Settings first.".into()); }','if client_id.len() < 8 { return Err("Microsoft sign-in is not configured by the Axolot administrator yet.".into()); }')
p.write_text(s,encoding="utf-8")
